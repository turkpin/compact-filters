{
  "name": "@turkpin/compact-filters",
  "version": "0.5.0",
  "private": false,
  "description": "Dynamic filter bar and date range picker for React 19 and Tailwind CSS v4, themed with shadcn/ui tokens",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turkpin/compact-filters.git"
  },
  "homepage": "https://turkpin.github.io/compact-filters/",
  "bugs": {
    "url": "https://github.com/turkpin/compact-filters/issues"
  },
  "keywords": [
    "date-range-picker",
    "filter",
    "filter-bar",
    "radix-ui",
    "react",
    "react-component",
    "shadcn",
    "tailwindcss"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./date-range": "./dist/date-range.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test 'test/**/*.test.js'",
    "prepublishOnly": "npm test",
    "demo": "node scripts/demo.js",
    "screenshots": "node scripts/demo.js && node scripts/screenshots.js"
  },
  "peerDependencies": {
    "@radix-ui/react-dropdown-menu": "^2",
    "@radix-ui/react-popover": "^1",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3"
  },
  "devDependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@parcel/watcher": "^2.6.0"
  }
}
